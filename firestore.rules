rules_version = '2';
// Musa OS security rules — mirrors src/lib/permissions.ts
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // The people who run Musa OS (keep in step with src/lib/owner.ts). Email must be verified —
    // they sign in with Google, which verifies it.
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['chimutashureece@gmail.com', 'chimutashutanatswa13@gmail.com'];
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function school(id) { return get(/databases/$(database)/documents/schools/$(id)).data; }
    // A demo school locks for everyone in it once its day is over.
    function schoolOpen(id) { return !(school(id).get('demo', false) == true && request.time.toMillis() > school(id).get('demoExpiresAt', 0)); }
    function member(schoolId) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().schoolId == schoolId && me().get('disabled', false) != true && schoolOpen(schoolId);
    }
    function role() { return me().role; }
    function isStaff() { return role() in ['admin', 'teacher', 'bursar']; }
    function isFamily() { return role() in ['parent', 'student']; }
    function myStudent(id) { return id in me().get('studentIds', []); }
    function untouched(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // The owners can see and fix everything (approve schools, extend or end demos).
    match /{document=**} {
      allow read, write: if isOwner();
    }

    // ---------------------------------------------------------------- users --
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (member(resource.data.schoolId) && role() == 'admin'));
      // the demo visitor's own profile, created with their demo school in one batch
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.get('demo', false) == true
        && !exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.demo == true;
      // admins manage accounts in their own school (but can't hand out demo powers or change a demo's end)
      allow create: if member(request.resource.data.schoolId) && role() == 'admin'
        && request.resource.data.get('demo', false) == false && !('demoExpiresAt' in request.resource.data);
      allow update: if member(request.resource.data.schoolId) && role() == 'admin' && untouched(['demo', 'demoExpiresAt']);
      // demo schools: the visitor may switch which role they are viewing the school as
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.get('demo', false) == true
        && school(resource.data.schoolId).get('demo', false) == true
        && schoolOpen(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.role in ['admin', 'teacher', 'bursar', 'parent', 'student']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'staffId', 'studentIds', 'classIds']);
      allow delete: if member(resource.data.schoolId) && role() == 'admin';
    }

    // ---------------------------------------------------- school requests --
    // schoolRequests/{uid}: a head asking Musa OS for a real school (new, or keeping their demo).
    match /schoolRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['new', 'upgrade']
        && (request.resource.data.kind == 'new'
            || school(request.resource.data.schoolId).ownerUid == request.auth.uid);
      allow get: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.status != 'approved';
    }

    // ---------------------------------------------------------- join codes --
    // Six-letter codes people type to ask to join a school. Anyone may look one up.
    match /schoolCodes/{code} {
      allow get: if true;
      allow create: if signedIn() && (
        getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid
        || (member(request.resource.data.schoolId) && role() == 'admin'));
      allow delete: if member(resource.data.schoolId) && role() == 'admin';
    }

    // ------------------------------------------------------- join requests --
    // joinRequests/{uid}: sent by the person signing up, answered by the head of that school.
    match /joinRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['teacher', 'bursar', 'parent', 'student']
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && !exists(/databases/$(database)/documents/users/$(uid));
      allow get: if signedIn() && (request.auth.uid == uid || (member(resource.data.schoolId) && role() == 'admin'));
      allow list: if member(resource.data.schoolId) && role() == 'admin';
      allow update: if member(resource.data.schoolId) && role() == 'admin'
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['approved', 'declined'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // --------------------------------------------------------------- school --
    match /schools/{schoolId} {
      allow read: if member(schoolId);
      // Anyone may open ONE demo school per login (its id comes from the login, and each email has
      // one login), lasting at most a day. Real schools are only created by the owners.
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.demoEmail == request.auth.token.email
        && schoolId.matches('demo-[a-z0-9]+')
        && !exists(/databases/$(database)/documents/schools/$(schoolId))
        && request.resource.data.demo == true
        && request.resource.data.demoExpiresAt is int
        && request.resource.data.demoExpiresAt <= request.time.toMillis() + 86700000;
      allow update: if member(schoolId) && role() == 'admin' && untouched(['demo', 'demoExpiresAt', 'ownerUid']);

      // settings: first write happens in the create batch
      match /settings/{doc} {
        allow read: if member(schoolId);
        allow write: if (member(schoolId) && role() == 'admin')
          || (signedIn() && getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid
              && !exists(/databases/$(database)/documents/schools/$(schoolId)/settings/main));
      }

      // readable by every member of the school
      match /{col}/{doc} {
        allow read: if member(schoolId) && (
          col in ['classes', 'subjects', 'staff', 'allocations', 'timetable', 'assessments', 'events', 'announcements', 'books', 'feeStructures']
          || (isStaff() && !(col in ['invoices', 'payments']) && !(role() == 'bursar' && col in ['rubrics', 'submissions', 'corrections']))
          || (isStaff() && col in ['invoices', 'payments'] && role() in ['admin', 'bursar'])
          || (isFamily() && col == 'students' && myStudent(doc))
          || (isFamily() && col in ['marks', 'invoices', 'payments', 'incidents', 'loans', 'reports', 'remarks', 'submissions'] && myStudent(resource.data.studentId))
          || (isFamily() && col == 'attendance' && resource.data.classId in me().get('classIds', []))
        );
        allow write: if member(schoolId) && (
          role() == 'admin'
          || (role() == 'teacher' && col in ['attendance', 'assessments', 'marks', 'remarks', 'incidents', 'rubrics', 'submissions', 'corrections', 'announcements', 'books', 'loans'])
          || (role() == 'bursar' && col in ['feeStructures', 'invoices', 'payments', 'announcements'])
        );
      }
    }
  }
}
